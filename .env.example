# Local-first LLM provider (default in this fork)
STUDENTSIM_LLM_PROVIDER=llamacpp
LLAMACPP_BASE_URL=http://127.0.0.1:8081/v1
LLAMACPP_SCORING_BASE_URL=http://127.0.0.1:8081/v1
LLAMACPP_MODEL=qwen38-code

# Optional Azure fallback. Only required when STUDENTSIM_LLM_PROVIDER=azure_openai.
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=<key>
